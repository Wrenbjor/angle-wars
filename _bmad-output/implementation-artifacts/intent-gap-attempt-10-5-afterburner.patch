+      this.dirX = mx / mag;
+      this.dirY = my / mag;
+    } else {
+      this.dirX = Math.cos(this.ship.angle);
+      this.dirY = Math.sin(this.ship.angle);
+    }
+    this.active = true;
+    this.remainingMs = DASH_DURATION_MS;
+    this.cooldownRemainingMs = cooldown;
