+import { describe, it, expect } from 'vitest';
+import { DashSystem } from './DashSystem.js';
+import { CollisionSystem } from './CollisionSystem.js';
+import { Pool } from '../core/Pool.js';
+import { createSeeker } from '../entities/Seeker.js';
+import { createGreenSquare } from '../entities/GreenSquare.js';
+import { createArmored } from '../entities/Armored.js';
+import { createBullet } from '../entities/Bullet.js';
+import { createPlayerShip } from '../entities/PlayerShip.js';
+import { InputState } from '../input/InputState.js';
+import { createPlayerStats } from '../state/PlayerStats.js';
+import {
+  FIXED_STEP_MS,
+  DASH_DURATION_MS,
+  DASH_COOLDOWN_FLOOR_MS,
+  DASH_CONTACT_DAMAGE,
+  SEEKER_RADIUS,
+  SHIP_RADIUS,
+  ARMORED_HP,
+} from '../config/constants.js';
+
+// Story 10.5 — DashSystem owns the dash's RUNTIME state (the live cooldown, the active
+// window, the direction) while the shared playerStats store owns only the derived
+// PARAMETERS. This suite covers the I/O-matrix rows this system owns: the cooldown, the
+// window, the direction (including the zero-intent facing fallback), the consumed-and-
+// discarded press, the Lv4+ contact sweep through CollisionSystem.applyPlayerDamage, the
+// two public queries, and all four sanitizers. The MOVEMENT integration lives in
+// playerMovementSystem.test.js, the DEATH gate in playerDeathSystem.test.js, the TRAIL in
+// particleSystem.test.js, and the assembled-world chain in buildArenaWorld.test.js.
+
+const DT = FIXED_STEP_MS;
+
+// The five per-level fold results (pinned against the real registry in
+// playerStats.test.js — restated here as this system's input vocabulary).
+const LV1 = { moveSpeedMult: 1.12 };
+const LV2 = { moveSpeedMult: 1.2, dashCooldownMs: 3000 };
+const LV3 = { moveSpeedMult: 1.25, dashCooldownMs: 3000, dashIFrames: 1 };
+const LV4 = {
+  moveSpeedMult: 1.25,
+  dashCooldownMs: 2000,
+  dashIFrames: 1,
+  dashDamage: 1,
+};
+const LV5 = {
+  moveSpeedMult: 1.35,
+  dashCooldownMs: 2000,
+  dashIFrames: 1,
+  dashDamage: 1,
+  dashTrail: 1,
+};
+
+/**
+ * A dash system over a fresh ship, a REAL CollisionSystem (so the damage path under
+ * test is the very one bullets use), three archetype pools, and a real player-stat
+ * store seeded with the given fields. `stats: null` models a missing store.
+ */
+function makeSystem(stats = {}) {
+  const ship = createPlayerShip();
+  const input = new InputState();
+  const seekerPool = new Pool(createSeeker);
+  const squarePool = new Pool(createGreenSquare);
+  const armoredPool = new Pool(createArmored);
+  const enemyPools = [seekerPool, squarePool, armoredPool];
+  const bulletPool = new Pool(createBullet);
+  const collisionSystem = new CollisionSystem(bulletPool, enemyPools);
+  const playerStats = stats === null ? null : { ...createPlayerStats(), ...stats };
+  const system = new DashSystem(ship, input, enemyPools, collisionSystem, playerStats);
+  return {
+    ship,
+    input,
+    seekerPool,
+    squarePool,
+    armoredPool,
+    enemyPools,
+    collisionSystem,
+    playerStats,
+    system,
+  };
+}
+
+function addSeeker(pool, x, y, telegraphMs = 0) {
+  const s = pool.acquire();
+  s.x = x;
+  s.y = y;
+  s.vx = 0;
+  s.vy = 0;
+  s.telegraphMs = telegraphMs;
+  return s;
+}
+
+/** Queue a dash press and advance one fixed step. */
+function pressAndStep(h, dt = DT) {
+  h.input.queueDash();
+  h.system.fixedUpdate(dt);
+}
+
+describe('DashSystem — opening a dash', () => {
+  it('a press with the cooldown ready opens the window, sets the direction and bumps dashSeq', () => {
+    const h = makeSystem(LV2);
+    h.input.setMove(1, 0);
+
+    pressAndStep(h);
+
+    expect(h.system.active).toBe(true);
+    expect(h.system.remainingMs).toBe(DASH_DURATION_MS);
+    expect(h.system.cooldownRemainingMs).toBe(LV2.dashCooldownMs);
+    expect(h.system.dirX).toBeCloseTo(1, 9);
+    expect(h.system.dirY).toBeCloseTo(0, 9);
+    expect(h.system.dashSeq).toBe(1);
+  });
+
+  it('normalizes the move intent (a half-deflected diagonal still dashes at unit length)', () => {
+    const h = makeSystem(LV2);
+    h.input.setMove(0.3, 0.4); // magnitude 0.5
+
+    pressAndStep(h);
+
+    expect(Math.hypot(h.system.dirX, h.system.dirY)).toBeCloseTo(1, 9);
+    expect(h.system.dirX).toBeCloseTo(0.6, 9);
+    expect(h.system.dirY).toBeCloseTo(0.8, 9);
+  });
+
+  it('at ZERO move intent falls back to the ship facing (the ship always carries one)', () => {
+    const h = makeSystem(LV2);
+    h.ship.angle = Math.PI / 2; // facing straight down
+    h.input.setMove(0, 0);
+
+    pressAndStep(h);
+
+    expect(h.system.active).toBe(true);
+    expect(h.system.dirX).toBeCloseTo(0, 9);
+    expect(h.system.dirY).toBeCloseTo(1, 9);
+  });
+
+  it('starts inert: no press, no dash, no cooldown, no seq', () => {
+    const h = makeSystem(LV5);
+    for (let i = 0; i < 300; i++) h.system.fixedUpdate(DT);
+    expect(h.system.active).toBe(false);
+    expect(h.system.remainingMs).toBe(0);
+    expect(h.system.cooldownRemainingMs).toBe(0);
+    expect(h.system.dashSeq).toBe(0);
+  });
+});
+
+describe('DashSystem — the window and the cooldown', () => {
+  it('the window closes EXACTLY at DASH_DURATION_MS of accumulated dt', () => {
+    const h = makeSystem(LV2);
+    h.input.setMove(1, 0);
+    pressAndStep(h);
+
+    // The opening tick does not consume the window (it is set after the countdown).
+    let elapsed = 0;
+    while (h.system.active) {
+      h.system.fixedUpdate(DT);
+      elapsed += DT;
+      expect(elapsed).toBeLessThanOrEqual(DASH_DURATION_MS + DT);
+    }
+    expect(elapsed).toBeGreaterThanOrEqual(DASH_DURATION_MS);
+    expect(h.system.remainingMs).toBe(0); // never a negative remainder
+  });
+
+  it('a single dt larger than the whole window closes it in one tick', () => {
+    const h = makeSystem(LV2);
+    pressAndStep(h);
+    h.system.fixedUpdate(DASH_DURATION_MS * 10);
+    expect(h.system.active).toBe(false);
+    expect(h.system.remainingMs).toBe(0);
+  });
+
+  it('the cooldown counts down and CLAMPS at 0 (never negative)', () => {
+    const h = makeSystem(LV2);
+    pressAndStep(h);
+    expect(h.system.cooldownRemainingMs).toBe(3000);
+
+    h.system.fixedUpdate(1000);
+    expect(h.system.cooldownRemainingMs).toBe(2000);
+    h.system.fixedUpdate(99999);
+    expect(h.system.cooldownRemainingMs).toBe(0);
+  });
+
+  it('the cooldown starts at dash START — the window always closes long before it', () => {
+    const h = makeSystem(LV4);
+    pressAndStep(h);
+    // Run out the window; the cooldown is still deep in flight.
+    for (let i = 0; i < 20; i++) h.system.fixedUpdate(DT);
+    expect(h.system.active).toBe(false);
+    expect(h.system.cooldownRemainingMs).toBeGreaterThan(0);
+    expect(LV4.dashCooldownMs).toBeGreaterThan(DASH_DURATION_MS);
+  });
+
+  it('re-dashes the instant the cooldown reaches 0', () => {
+    const h = makeSystem(LV2);
+    pressAndStep(h);
+    expect(h.system.dashSeq).toBe(1);
+    h.system.fixedUpdate(3000); // window closed, cooldown exhausted
+
+    pressAndStep(h);
+    expect(h.system.dashSeq).toBe(2);
+    expect(h.system.active).toBe(true);
+  });
+});
+
+describe('DashSystem — a press that cannot open a dash is consumed and DISCARDED', () => {
+  it('during the cooldown: no seq bump, no cooldown refresh, and not buffered', () => {
+    const h = makeSystem(LV2);
+    pressAndStep(h);
+    h.system.fixedUpdate(1000); // window closed; 2000ms of cooldown left
+    const cooldownBefore = h.system.cooldownRemainingMs;
+
+    pressAndStep(h); // press while cooling down
+
+    expect(h.system.dashSeq).toBe(1); // no second dash
+    expect(h.input.dashQueued).toBe(false); // consumed, not buffered
+    // The cooldown kept counting down normally (one dt), never refreshed to 3000.
+    expect(h.system.cooldownRemainingMs).toBeCloseTo(cooldownBefore - DT, 9);
+
+    // Running the cooldown out does NOT then fire the discarded press.
+    for (let i = 0; i < 200; i++) h.system.fixedUpdate(DT);
+    expect(h.system.dashSeq).toBe(1);
+    expect(h.system.active).toBe(false);
+  });
+
+  it('mid-dash: no seq bump, no cooldown refresh, no direction change', () => {
+    const h = makeSystem(LV2);
+    h.input.setMove(1, 0);
+    pressAndStep(h);
