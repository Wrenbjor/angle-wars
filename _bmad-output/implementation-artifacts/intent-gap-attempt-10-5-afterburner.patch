+describe('PlayerMovementSystem — the dash branch (Story 10.5)', () => {
+  it('applies a CONSTANT velocity for the whole window regardless of held intent', () => {
+    const dash = dashStub(1, 0);
+    const h = makeSystem105({ move: [-1, -1], stats: { moveSpeedMult: 1.35 }, dash });
+    for (let i = 0; i < 10; i++) {
+      h.system.fixedUpdate(DT);
+      expect(h.ship.vx).toBeCloseTo(DASH_SPEED, 9);
+      expect(h.ship.vy).toBeCloseTo(0, 9);
+    }
+  });
+
+  it('suppresses thrust and drag (the burst is unaffected by either)', () => {
+    // With drag applied, a constant-velocity assignment would decay; with thrust
+    // applied, the opposite-held stick would bend it. Neither happens.
+    const dash = dashStub(0, 1);
+    const h = makeSystem105({ ship: { vx: 999, vy: -999 }, move: [1, 0], dash });
+    h.system.fixedUpdate(DT);
+    expect(h.ship.vx).toBeCloseTo(0, 9); // the pre-dash velocity is overwritten
+    expect(h.ship.vy).toBeCloseTo(DASH_SPEED, 9);
+  });
+
+  it('travels ~DASH_SPEED x DASH_DURATION_MS over the window, clearing SPAWN_SAFE_RADIUS but under BLACKHOLE_GRAVITY_RADIUS', () => {
+    const dash = dashStub(1, 0);
+    const h = makeSystem105({ ship: { x: 200, y: ARENA_HEIGHT / 2 }, dash });
+    const x0 = h.ship.x;
+    // Step the exact window in whole fixed steps.
+    const ticks = Math.round(DASH_DURATION_MS / DT);
+    for (let i = 0; i < ticks; i++) h.system.fixedUpdate(DT);
+    const travelled = h.ship.x - x0;
+
+    // Computed independently of the constants' product (ticks x per-tick distance).
+    expect(travelled).toBeCloseTo(ticks * DASH_SPEED * DT_SEC, 6);
+    // The two properties the constants' comment claims.
+    const nominal = (DASH_SPEED * DASH_DURATION_MS) / 1000;
+    expect(nominal).toBeGreaterThan(SPAWN_SAFE_RADIUS);
+    expect(nominal).toBeLessThan(BLACKHOLE_GRAVITY_RADIUS);
+  });
+
+  it('faces the DASH direction (DASH_SPEED is far above SHIP_MIN_TURN_SPEED)', () => {
+    const dash = dashStub(0, -1);
+    const h = makeSystem105({ ship: { angle: 0 }, dash });
+    h.system.fixedUpdate(DT);
+    expect(h.ship.angle).toBeCloseTo(-Math.PI / 2, 6);
+    expect(DASH_SPEED).toBeGreaterThan(SHIP_MIN_TURN_SPEED);
+  });
+
+  it('still clamps to the arena interior — a dash into a wall GRINDS without ending the window', () => {
+    const dash = dashStub(-1, 0);
+    const minX = ARENA_BORDER_INSET + SHIP_RADIUS;
+    const h = makeSystem105({ ship: { x: minX + 5, y: ARENA_HEIGHT / 2 }, dash });
+
+    for (let i = 0; i < 20; i++) {
+      h.system.fixedUpdate(DT);
+      expect(h.ship.x).toBe(minX); // clamped, never outside
+      // The clamp zeroes vx, but the dash branch RE-APPLIES it next tick.
+      expect(h.ship.vx).toBe(0);
+    }
+    // The window is DashSystem's to close — movement never touched `active`.
+    expect(dash.active).toBe(true);
+  });
+
+  it('resumes ordinary movement the instant the window closes', () => {
+    const dash = dashStub(1, 0);
+    const h = makeSystem105({ move: [0, 0], dash });
+    h.system.fixedUpdate(DT);
+    expect(h.ship.vx).toBeCloseTo(DASH_SPEED, 9);
+
+    dash.active = false;
+    h.system.fixedUpdate(DT);
+    // Drag applies again (no thrust held), so the speed drops below the burst.
+    expect(h.ship.vx).toBeLessThan(DASH_SPEED);
+    expect(h.ship.vx).toBeGreaterThan(0);
+  });
+
+  it('a null dash system leaves the ordinary path byte-identical', () => {
+    const legacy = makeSystem({ move: [1, 0] });
+    const withStore = makeSystem105({ move: [1, 0], stats: null, dash: null });
+    for (let i = 0; i < 50; i++) {
+      legacy.system.fixedUpdate(DT);
+      withStore.system.fixedUpdate(DT);
+    }
+    expect(withStore.ship.x).toBe(legacy.ship.x);
+    expect(withStore.ship.vx).toBe(legacy.ship.vx);
+  });
