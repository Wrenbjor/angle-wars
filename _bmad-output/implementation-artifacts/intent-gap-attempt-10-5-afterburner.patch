+// --- Story 10.5: Afterburner move speed + the dash branch --------------------
+
+/**
+ * A movement system with the optional Story-10.5 args wired: a player-stat store
+ * (`stats`) and a minimal dash stub. `dash: null` keeps the pre-10.5 four-arg shape.
+ */
+function makeSystem105({ ship: shipOverrides = {}, move = [0, 0], stats = null, dash = null } = {}) {
+  const ship = { ...createPlayerShip(), ...shipOverrides };
+  const input = new InputState();
+  input.setMove(move[0], move[1]);
+  const system = new PlayerMovementSystem(ship, input, stats, dash);
+  return { ship, input, system };
+}
+
+/** A stand-in for DashSystem's read surface (active + unit direction). */
+function dashStub(dirX, dirY, active = true) {
+  return { active, dirX, dirY };
+}
+
+/**
+ * Measure the system's EFFECTIVE max-speed cap. Seed a velocity far above any cap and
+ * step once from arena center: drag scales it (still enormous), the cap then clamps it
+ * to exactly the cap, and the re-centering keeps the arena clamp out of the reading.
+ *
+ * Deliberately NOT "terminal speed under sustained thrust": that saturates at the
+ * thrust/drag equilibrium (~598 px/s), which is BELOW some of the shipped caps — so it
+ * would measure the wrong thing for the higher rungs.
+ */
+function capOf(system, ship) {
+  ship.x = ARENA_WIDTH / 2;
+  ship.y = ARENA_HEIGHT / 2;
+  ship.vx = 1e6;
+  ship.vy = 0;
+  system.fixedUpdate(DT);
+  return Math.hypot(ship.vx, ship.vy);
+}
+
+describe('PlayerMovementSystem — moveSpeedMult (Story 10.5)', () => {
+  it('a TWO-arg construction is byte-identical to today (no store, no dash)', () => {
+    const legacy = makeSystem({ move: [1, 0] });
+    const explicit = makeSystem105({ move: [1, 0], stats: null, dash: null });
+    for (let i = 0; i < 200; i++) {
+      legacy.system.fixedUpdate(DT);
+      explicit.system.fixedUpdate(DT);
+    }
+    expect(explicit.ship.vx).toBe(legacy.ship.vx);
+    expect(explicit.ship.x).toBe(legacy.ship.x);
+    // …and the effective cap is still exactly the pre-10.5 SHIP_MAX_SPEED.
+    const l2 = makeSystem({ move: [0, 0] });
+    expect(capOf(l2.system, l2.ship)).toBeCloseTo(SHIP_MAX_SPEED, 6);
+  });
+
+  it('scales the max-speed cap across the five shipped rungs', () => {
+    // The folded TOTALS the real registry produces (pinned in playerStats.test.js).
+    for (const mult of [1.12, 1.2, 1.25, 1.25, 1.35]) {
+      const h = makeSystem105({ move: [0, 0], stats: { moveSpeedMult: mult } });
+      expect(capOf(h.system, h.ship), `x${mult}`).toBeCloseTo(SHIP_MAX_SPEED * mult, 6);
+    }
+  });
+
+  it('leaves ACCEL and DRAG untouched — only the cap moves', () => {
+    const base = makeSystem({ move: [1, 0] });
