+      this._sweep();
+    }
+
+    // (4) Input. Read-and-clear ALWAYS, before any gate: a press during the cooldown or
+    //     mid-dash is DISCARDED, never buffered into the next opening (the
+    //     InputState.consumeBomb idiom — one press, at most one dash).
+    const requested = this.inputState.consumeDash();
