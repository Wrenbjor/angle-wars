+    { moveSpeedMult: 1.25, dashCooldownMs: 3000, dashIFrames: 1, dashDamage: 0, dashTrail: 0 },
+    { moveSpeedMult: 1.25, dashCooldownMs: 2000, dashIFrames: 1, dashDamage: 1, dashTrail: 0 },
+    { moveSpeedMult: 1.35, dashCooldownMs: 2000, dashIFrames: 1, dashDamage: 1, dashTrail: 1 },
+  ];
+
+  it('folds each of the five shipped levels to its exact derived parameters', () => {
+    EXPECTED_BY_LEVEL.forEach((expected, i) => {
+      const level = i + 1;
+      const ps = createPlayerStats();
+      recomputePlayerStats(ps, { afterburner: level }, ITEM_REGISTRY);
+      expect(ps.moveSpeedMult, `L${level} moveSpeedMult`).toBeCloseTo(
+        expected.moveSpeedMult,
+        10,
+      );
+      expect(ps.dashCooldownMs, `L${level} dashCooldownMs`).toBe(expected.dashCooldownMs);
+      expect(ps.dashIFrames, `L${level} dashIFrames`).toBe(expected.dashIFrames);
+      expect(ps.dashDamage, `L${level} dashDamage`).toBe(expected.dashDamage);
+      expect(ps.dashTrail, `L${level} dashTrail`).toBe(expected.dashTrail);
+    });
+  });
+
+  it('Lv1 grants speed but NO dash (the cooldown IS the enable flag)', () => {
+    const ps = createPlayerStats();
+    recomputePlayerStats(ps, { afterburner: 1 }, ITEM_REGISTRY);
+    expect(ps.moveSpeedMult).toBeCloseTo(1.12, 10);
+    expect(ps.dashCooldownMs).toBe(0); // DashSystem reads 0 as "no dash at all"
+  });
+
+  it('an UNOWNED Afterburner leaves all five fields at their base', () => {
+    const ps = createPlayerStats();
+    recomputePlayerStats(ps, { overcharge: 5, 'spread-cannon': 5 }, ITEM_REGISTRY);
+    expect(ps.moveSpeedMult).toBe(PLAYER_STATS_BASE.moveSpeedMult); // 1
+    expect(ps.dashCooldownMs).toBe(0);
+    expect(ps.dashIFrames).toBe(0);
+    expect(ps.dashDamage).toBe(0);
+    expect(ps.dashTrail).toBe(0);
+  });
+
+  it('an offense item owned alongside leaves every Afterburner field unaffected', () => {
+    // The stacking check from both sides: no offense item authors a movement/dash key,
+    // so a maxed offense build cannot speed the ship up or shorten the dash cooldown —
+    // and the Afterburner cannot inflate the offense rungs.
+    const ps = createPlayerStats();
+    recomputePlayerStats(
+      ps,
+      { afterburner: 5, overcharge: 5, 'spread-cannon': 5 },
+      ITEM_REGISTRY,
+    );
+    expect(ps.moveSpeedMult).toBeCloseTo(1.35, 10);
+    expect(ps.dashCooldownMs).toBe(2000);
+    expect(ps.dashIFrames).toBe(1);
+    expect(ps.dashDamage).toBe(1);
+    expect(ps.dashTrail).toBe(1);
+    // …and the offense rungs are exactly the two-item additive stack, unchanged.
+    expect(ps.fireRateMult).toBeCloseTo(1.7, 10);
+    expect(ps.damageMult).toBeCloseTo(1.95, 10);
+    expect(ps.spreadWays).toBe(9);
+  });
+
+  it('a re-fold on an unrelated pick would RESET the derived params (why runtime state lives on DashSystem)', () => {
+    // The property that forces the split: the fold wipes and re-derives EVERY field on
+    // every pick, so anything live kept here would be refunded once per level.
+    const ps = createPlayerStats();
+    recomputePlayerStats(ps, { afterburner: 4 }, ITEM_REGISTRY);
+    expect(ps.dashCooldownMs).toBe(2000);
+    // Simulate a stray live-timer write, then pick an unrelated item.
+    ps.dashCooldownMs = 1234;
+    recomputePlayerStats(ps, { afterburner: 4, overcharge: 1 }, ITEM_REGISTRY);
+    expect(ps.dashCooldownMs).toBe(2000); // re-derived, the stray write gone
+  });
+});
