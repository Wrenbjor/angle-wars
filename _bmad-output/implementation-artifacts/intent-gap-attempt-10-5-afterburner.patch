+    // One real bullet kill through fixedUpdate first, so the helper is appending to a
+    // NON-empty latch set exactly as the dash does.
+    addBullet(bulletPool, 100, 100);
+    addSeeker(enemyPool, 100, 100);
+    system.fixedUpdate(DT);
+    expect(system.bulletKillCount).toBe(1);
+    expect(system.bulletDamageCount).toBe(1);
+
+    const extra = [];
+    for (let i = 0; i < 5; i++) extra.push(addSeeker(enemyPool, 200 + i, 500 + i));
+    for (const s of extra) system.applyPlayerDamage(s, enemyPool, 1);
+
+    expect(system.bulletKillCount).toBe(6);
+    expect(system.bulletDamageCount).toBe(6);
+    expect(system.killedEnemies).toHaveLength(6);
+    expect(system.bulletKillX).toHaveLength(6);
+    expect(system.bulletKillY).toHaveLength(6);
+    expect(system.bulletKillXp).toHaveLength(6);
+    // Index alignment: killedEnemies[k] ↔ bulletKillX/Y[k].
+    for (let k = 1; k < 6; k++) {
+      expect(system.bulletKillX[k]).toBe(200 + (k - 1));
+      expect(system.bulletKillY[k]).toBe(500 + (k - 1));
+    }
+  });
+
+  it('every latch is RESET at the top of the next fixedUpdate (no cross-tick carry-over)', () => {
+    const { enemyPool, system } = makeSystem();
+    system.fixedUpdate(DT);
+    system.applyPlayerDamage(addSeeker(enemyPool, 1, 2), enemyPool, 1);
+    expect(system.bulletKillCount).toBe(1);
+    expect(system.bulletDamageCount).toBe(1);
+
+    system.fixedUpdate(DT);
+
+    expect(system.bulletKillCount).toBe(0);
+    expect(system.bulletDamageCount).toBe(0);
+    expect(system.killedEnemies).toHaveLength(0);
+    expect(system.bulletKillX).toHaveLength(0);
+  });
+
+  it('routes a kill to the pool it was GIVEN (multi-pool release correctness)', () => {
+    const bulletPool = new Pool(createBullet);
+    const seekerPool = new Pool(createSeeker);
+    const squarePool = new Pool(createGreenSquare);
+    const system = new CollisionSystem(bulletPool, [seekerPool, squarePool]);
+    system.fixedUpdate(DT);
+    const sq = squarePool.acquire();
+    sq.x = 5;
+    sq.y = 6;
+
+    system.applyPlayerDamage(sq, squarePool, 1);
+
+    expect(squarePool.activeCount).toBe(0);
+    expect(seekerPool.activeCount).toBe(0);
+    expect(squarePool.freeCount).toBe(1);
+  });
+
+  it('guards a non-finite xp on the snapshot (mirrors the pre-extraction behavior)', () => {
+    const { enemyPool, system } = makeSystem();
+    system.fixedUpdate(DT);
+    const s = addSeeker(enemyPool, 7, 8);
+    s.xp = NaN;
+
+    system.applyPlayerDamage(s, enemyPool, 1);
+
+    expect(system.bulletKillXp).toEqual([0]);
+  });
+});
