+   */
+  trailActive() {
+    return this.active && this._trailEnabled();
+  }
+
+  /**
+   * Advance one fixed step: tick the cooldown, tick/close the window, sweep for contact
+   * damage, then consume the input latch and possibly open a new dash.
+   *
+   * The sweep runs at the ship's CURRENT position each tick, so the whole dash PATH is
+   * covered across the window's ticks with no tunnelling: per-tick travel at DASH_SPEED
+   * is ~21.7px (1300 px/s x 16.7ms), while the smallest ship+enemy contact radius
+   * already exceeds that — consecutive sweep discs overlap.
+   *
+   * The cooldown starts at dash START, not at window end. The window (180ms) always
+   * closes long before the cooldown (2000ms at the fastest shipped rung) does, so the
+   * two never race.
