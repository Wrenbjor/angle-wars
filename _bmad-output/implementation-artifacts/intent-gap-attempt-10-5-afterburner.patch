diff --git a/src/systems/DashSystem.js b/src/systems/DashSystem.js
new file mode 100644
index 0000000..6fc98e3
--- /dev/null
+++ b/src/systems/DashSystem.js
@@ -0,0 +1,311 @@
+import { System } from '../core/System.js';
+import {
+  DASH_DURATION_MS,
+  DASH_COOLDOWN_FLOOR_MS,
+  DASH_CONTACT_DAMAGE,
+} from '../config/constants.js';
+
+// DashSystem — the Afterburner's dash RUNTIME state (Story 10.5 / PRD §13.4),
+// Phaser-free.
+//
+// The dash is the second Epic-10 effect that is not a pure stat read, and it follows
+// NaniteShieldSystem's split exactly:
+//   - the FOLD (state/PlayerStats.js) owns the DERIVED PARAMETERS — `dashCooldownMs`
+//     (which doubles as the enable flag) plus the `dashIFrames` / `dashDamage` /
+//     `dashTrail` flags;
+//   - THIS system owns the LIVE state — the cooldown countdown, the active window and
+//     the dash direction.
+// They are split because `recomputePlayerStats` resets every field and re-derives the
+// whole store on EVERY card pick: a live cooldown kept there would be silently
+// refunded by picking any unrelated item (a free dash once per level).
+//
+// This system does NOT move the ship. PlayerMovementSystem stays the SOLE writer of
+// ship.vx/vy/x/y; it reads `active`/`dirX`/`dirY` from here and applies the velocity.
+// Two movers is precisely the failure mode that rule exists to prevent.
+//
+// REGISTRATION SLOT (see scenes/buildArenaWorld.js) is load-bearing in three
+// directions, and the trade it encodes is the story's central design decision:
+//   - immediately AFTER CollisionSystem, because that system RESETS `killedEnemies`,
+//     `bulletKillCount`, `bulletKillX/Y/Xp` and `bulletDamageCount` at the top of its
+//     own fixedUpdate. A dash sweep running before it would append into arrays about
+//     to be wiped;
+//   - BEFORE ScoringSystem (so a dash kill is SCORED) and before DpsTelemetrySystem /
+//     XpOrbSystem / ParticleSystem / GridFieldSystem (so it also drops an XP orb,
+//     sprays a burst and ripples the grid) — the full kill feedback a bullet kill
+//     gets. The BombSystem's silent, unscored removal is the deliberate ANTI-pattern
+//     here: a panic button should not farm score, but XP is progression currency and
+//     a dash that ate enemies without granting it would be a hidden penalty for using
+//     the item;
+//   - LATER in the tick than PlayerMovementSystem (slot 2), which is the unavoidable
+//     cost: movement applies a dash window one fixed step (16.7ms) after it opens.
+//     That lag is imperceptible, deterministic, and pinned by the ordering test.
+//
+// Zero per-tick allocation on BOTH paths: the cooldown/window are scalar arithmetic,
+// and the damage sweep materializes the pools into HOISTED scratch (with a parallel
+// `_owners` array) using one hoisted collect closure — the CollisionSystem/BombSystem
+// materialize-then-mutate convention, required here because `applyPlayerDamage`
+// releases to a pool and releasing inside `forEachActive` is unsafe.
+export class DashSystem extends System {
+  /**
+   * @param {{x:number,y:number,angle:number,radius:number}} ship The player ship — read
+   *   for the sweep origin and the zero-intent facing fallback. NEVER mutated here.
+   * @param {import('../input/InputState.js').InputState} inputState The shared input
+   *   seam carrying the latched dash request (`consumeDash`).
+   * @param {import('../core/Pool.js').Pool[]} enemyPools The five COMBAT archetype
+   *   pools the Lv4+ contact sweep damages. Deliberately `enemyPools`, never
+   *   `deathPools`: the Black Hole and the Mirror Reflector are immune to this kind of
+   *   contact, the same scoping NaniteShieldSystem's pulse and BombSystem.detonateAt
+   *   apply.
+   * @param {import('./CollisionSystem.js').CollisionSystem} collisionSystem The owner
+   *   of `applyPlayerDamage` — the SINGLE armor-respecting damage path bullets use, so
+   *   an armored enemy behaves identically whether a bullet or a dash hits it.
+   * @param {Object<string,number>|null} [playerStats=null] The shared player-stat store
+   *   the parameters are read from (optional — a null store means no dash ever, i.e.
+   *   exactly the pre-10.5 movement path).
+   */
+  constructor(ship, inputState, enemyPools, collisionSystem, playerStats = null) {
+    super();
+    this.ship = ship;
+    this.inputState = inputState;
+    this.enemyPools = enemyPools;
+    this.collisionSystem = collisionSystem;
+    this.playerStats = playerStats;
+
+    // Public runtime state.
+    /** Whether a dash window is currently open. PlayerMovementSystem reads this. */
+    this.active = false;
+    /** Milliseconds left in the open window (0 when not active). */
+    this.remainingMs = 0;
+    /** Milliseconds left before another dash may open (0 = ready). */
+    this.cooldownRemainingMs = 0;
+    /** Unit direction X of the current dash. */
+    this.dirX = 0;
+    /** Unit direction Y of the current dash. */
+    this.dirY = 0;
+    /**
+     * Public read-only observability latch, mirroring NaniteShieldSystem.absorbSeq and
+     * PlayerDeathSystem.deathSeq: a monotonic count of dashes STARTED. It exists
+     * because `active` does not change on a tick where a press lands while a dash is
+     * already running — without this, a real dash start would be indistinguishable
+     * from a press that was consumed and discarded. Published now so a future HUD /
+     * SFX cue has an edge to consume without touching this system again.
+     */
+    this.dashSeq = 0;
+
+    // Reusable sweep scratch (length-reset each use, never reallocated). `_owners` is
+    // parallel to `_enemies` — `_owners[i]` owns `_enemies[i]`, so a kill routes its
+    // release to the correct pool.
+    this._enemies = [];
+    this._owners = [];
+    // Hoisted collect callback + the pool being materialized, so the per-pool
+    // `forEachActive` reuses ONE closure instead of allocating a fresh arrow per pool
+    // per tick.
+    this._currentPool = null;
+    this._collectEnemy = (e) => {
+      this._enemies.push(e);
+      this._owners.push(this._currentPool);
+    };
+  }
+
+  /**
+   * The sanitized dash COOLDOWN interval (ms) off the shared store — or 0 meaning THE
+   * DASH IS DISABLED.
+   *
+   * This reader deliberately fails CLOSED where NaniteShieldSystem._rechargeIntervalMs
+   * fails open. A junk `shieldRechargeMs` still leaves a shield that works, just at a
+   * floored rate — that item's capability does not hinge on the value. Here the
+   * interval IS the enable flag: Afterburner Lv1 authors no `dashCooldownMs` precisely
+   * so Lv1 owns no dash. Falling back to a floor would MINT a dash the build never
+   * bought, so a missing store, a missing field, a non-finite value or a value <= 0 all
+   * resolve to 0 (no dash at all — the pre-10.5 movement path exactly).
+   *
+   * The DASH_COOLDOWN_FLOOR_MS clamp applies only to a value that is already finite and
+   * positive: a corrupted 1e-9 clamps UP to the floor, bounding the dash RATE at one
+   * per floor interval rather than one per tick. It is a SAFETY guard, never a balance
+   * lever — it sits 10x below the fastest shipped rung (2000ms).
+   * Allocates nothing.
+   * @returns {number} the sanitized interval in ms, or 0 for "no dash".
+   */
+  _cooldownMs() {
+    const ps = this.playerStats;
+    if (ps === null || ps === undefined) return 0;
+    const v = ps.dashCooldownMs;
+    if (!Number.isFinite(v) || v <= 0) return 0; // fails CLOSED — no dash
+    return v < DASH_COOLDOWN_FLOOR_MS ? DASH_COOLDOWN_FLOOR_MS : v;
+  }
+
+  /**
+   * Whether the Lv3+ dash i-frames are enabled — the `dashIFrames` flag, sanitized on
+   * the NaniteShieldSystem._knockbackEnabled terms: a missing store, a missing field, a
+   * non-finite value, a string, or anything below 1 all resolve to DISABLED.
+   * Allocates nothing.
+   * @returns {boolean}
+   */
+  _iFramesEnabled() {
+    const ps = this.playerStats;
+    if (ps === null || ps === undefined) return false;
+    const v = ps.dashIFrames;
+    return Number.isFinite(v) && v >= 1;
+  }
+
+  /**
+   * Whether the Lv4+ dash contact damage is enabled — the `dashDamage` FLAG. The damage
+   * MAGNITUDE is DASH_CONTACT_DAMAGE, deliberately a constant rather than a fold field
+   * (the fold is additive, so a magnitude there would double if a second item ever
+   * authored the key). Sanitized exactly as `_iFramesEnabled`.
+   * Allocates nothing.
+   * @returns {boolean}
+   */
+  _damageEnabled() {
+    const ps = this.playerStats;
+    if (ps === null || ps === undefined) return false;
+    const v = ps.dashDamage;
+    return Number.isFinite(v) && v >= 1;
+  }
+
+  /**
+   * Whether the Lv5 burning dash trail is enabled — the `dashTrail` FLAG. Cosmetic
+   * only: ParticleSystem reads it through `trailActive()` and emits particles; it
+   * damages nothing and leaves no lingering zone. Sanitized exactly as
+   * `_iFramesEnabled`.
+   * Allocates nothing.
+   * @returns {boolean}
+   */
+  _trailEnabled() {
+    const ps = this.playerStats;
+    if (ps === null || ps === undefined) return false;
+    const v = ps.dashTrail;
+    return Number.isFinite(v) && v >= 1;
+  }
+
+  /**
+   * Whether the player is currently invulnerable BECAUSE OF a dash (Lv3+ only).
+   * PlayerDeathSystem gates on this. Deliberately a QUERY rather than a written
+   * `playerState.invulnMs` top-up: this system owns the window, so nothing else has to
+   * count it down or reconcile it with the respawn/level-up windows.
+   * @returns {boolean}
+   */
+  iFramesActive() {
+    return this.active && this._iFramesEnabled();
+  }
+
+  /**
