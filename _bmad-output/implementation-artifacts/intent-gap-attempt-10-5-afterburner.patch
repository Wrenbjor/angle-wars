+  }
+
+  /**
+   * The Lv4+ contact sweep: damage every non-telegraphing COMBAT enemy overlapping the
+   * ship right now, through the SAME armor-respecting path a bullet uses.
+   *
+   * One hit per enemy per TICK, exactly like sustained fire: an enemy still in range
+   * next tick is damaged again, and an enemy KILLED this tick is released and simply
+   * absent from the next tick's materialization. A TELEGRAPHING (spawning-in) enemy is
+   * skipped entirely — the uniform non-lethality seam every other archetype-agnostic
+   * pass honours.
+   *
+   * Circle-circle overlap at `ship.radius + enemy.radius`, boundary inclusive (the
+   * CollisionSystem / PlayerDeathSystem convention). Allocates nothing.
+   * @private
+   */
+  _sweep() {
+    const pools = this.enemyPools;
+    if (!pools) return;
+    const enemies = this._enemies;
+    const owners = this._owners;
+    enemies.length = 0;
+    owners.length = 0;
+    for (let p = 0; p < pools.length; p++) {
+      this._currentPool = pools[p];
+      pools[p].forEachActive(this._collectEnemy);
+    }
+
+    const ship = this.ship;
+    const cs = this.collisionSystem;
+    if (!cs) return;
+    for (let i = 0; i < enemies.length; i++) {
+      const e = enemies[i];
+      if (e.telegraphMs > 0) continue;
+      const dx = ship.x - e.x;
+      const dy = ship.y - e.y;
+      const r = ship.radius + e.radius;
+      // Squared compare avoids a sqrt; <= so a boundary touch counts as contact.
+      if (dx * dx + dy * dy <= r * r) {
+        cs.applyPlayerDamage(e, owners[i], DASH_CONTACT_DAMAGE);
+      }
+    }
+  }
+}
