+    expect(h.system.dashSeq).toBe(0);
+    expect(h.system.cooldownRemainingMs).toBe(0);
+    expect(h.input.dashQueued).toBe(false);
+  });
+
+  it('at Lv1: speed only — the press is consumed and no dash opens', () => {
+    const h = makeSystem(LV1);
+    pressAndStep(h);
