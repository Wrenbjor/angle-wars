+++ b/src/config/itemRegistry.js
@@ -0,0 +1,164 @@
+// Item registry — the single data-driven source of truth for every arsenal item
+// (Story 10.1 / Epic 10).
+//
+// This replaces the Epic-8 PLACEHOLDER_CARDS pool. ONE definition per item is read
+// by the card offer (its `rarity`/`track` drive the weighted draw), the on-pick
+// application (its `maxLevel` caps the level, its per-level `stats` fold into
+// PlayerStats), the owned-state queries (level == ownedCards[id]), and the
+// forward-looking fusion checks (its `fusion` partner/epic). Adding an item is
+// content — a new frozen entry — not new plumbing.
+//
+// Each entry is duck-compatible with the retired card shape (it carries `id`,
+// `rarity`, `track`, and `title`, so cardOffer / LevelUpSystem / the ArenaScene
+// card overlay keep working unchanged) PLUS the framework fields:
+//   - id       : stable unique key; the ownership map + every query key off it.
+//   - name     : human-readable item name.
+//   - title    : the label the level-up overlay renders (kept == name so the
+//                existing overlay's `offer[i].title` read stays functional — the
+//                render path is deliberately untouched this story).
+//   - track    : 'offense' | 'defense' — the per-track slot-limit bucket.
+//   - rarity   : the positive BASE weight the draw multiplies by the
+//                ownership/level/slot factors (varied so weighting is observable).
+//   - maxLevel : the full-build level (ITEM_MAX_LEVEL = 5). An item's level is its
+//                owned count capped here; at this level it weighs 0 (never re-offered).
+//   - levels   : five per-level effect descriptors { level, desc, stats }. `desc`
+//                is the human text from the epic; `stats` is a modifier map folded
+//                into PlayerStats at the item's CURRENT level (per-level entries are
+//                totals-AT-that-level, not deltas summed across levels). This story
+//                registers the four items with EMPTY `stats: {}` — each item's real
+//                effect numbers land in its own story (10.2–10.5).
+//   - fusion   : { partner, epic } — the Epic-12 fusion recipe (a Lv5 item + a
+//                Lv3+ partner unlocks the epic), or null. Carried metadata only this
+//                story (fusion consumption is Epic 12); the framework tracks/exposes
+//                remnant state but does not consume it here.
+//
+// Entries and the array are frozen so no consumer can mutate the shared registry.
+
+import { ITEM_MAX_LEVEL } from './constants.js';
+
+// Build one frozen five-entry `levels` array from five human descriptions, each with
+// an EMPTY stats map (this story defers real effect numbers to the item's own story).
+// Freezing each level entry + its stats map keeps the whole definition immutable.
+function makeLevels(descs) {
+  return Object.freeze(
+    descs.map((desc, i) =>
+      Object.freeze({ level: i + 1, desc, stats: Object.freeze({}) }),
+    ),
+  );
+}
+
+/**
+ * The Epic-10 item registry: the four core arsenal items (Overcharge, Spread
+ * Cannon, Nanite Shield, Afterburner) at all five levels, with real id/name/track/
+ * rarity/fusion metadata and empty per-level `stats` (effect numbers deferred to
+ * each item's story). Frozen (array + every entry) so it is a shared immutable
+ * source of truth. The fusion partner/epic ids come from the PRD §13.5 fusion map.
+ * @type {ReadonlyArray<{ id: string, name: string, title: string,
+ *   track: 'offense'|'defense', rarity: number, maxLevel: number,
+ *   levels: ReadonlyArray<{ level: number, desc: string, stats: object }>,
+ *   fusion: { partner: string, epic: string }|null }>}
+ */
+export const ITEM_REGISTRY = Object.freeze([
+  // --- Offense -------------------------------------------------------------
+  // Overcharge: the common fusion key (a normal offense item on its base rarity
+  // weight). Global fire modifiers. Fusion: Overcharge Lv5 + any 2 offense Lv5 →
+  // Critical Resonance (the "any 2 offense" partner is a special multi-partner rule
+  // resolved by Epic 12; recorded here as the sentinel 'any-offense-x2').
+  Object.freeze({
+    id: 'overcharge',
+    name: 'Overcharge',
+    title: 'Overcharge',
+    track: 'offense',
+    rarity: 5,
+    maxLevel: ITEM_MAX_LEVEL,
+    levels: makeLevels([
+      '+15% damage',
+      '+25% damage, +10% fire rate',
+      '+35% damage, +20% fire rate',
+      '+45% damage, +30% fire rate',
+      '+60% damage, +40% fire rate',
+    ]),
+    fusion: Object.freeze({ partner: 'any-offense-x2', epic: 'critical-resonance' }),
+  }),
+  // Spread Cannon: the base-weapon evolution (always offered by ~Lv3 — that
+  // onboarding guarantee is Story 10.3). Fires through the existing firing seam.
+  // Fusion: Spread Cannon Lv5 + Piercing Lance Lv3 → Sunburst.
+  Object.freeze({
+    id: 'spread-cannon',
+    name: 'Spread Cannon',
+    title: 'Spread Cannon',
+    track: 'offense',
+    rarity: 4,
+    maxLevel: ITEM_MAX_LEVEL,
+    levels: makeLevels([
+      '3-way spread, 12°',
+      '5-way spread, 16°',
+      '+30% fire rate',
+      '7-way spread, 22°',
+      '9-way spread, +35% damage',
+    ]),
+    fusion: Object.freeze({ partner: 'piercing-lance', epic: 'sunburst' }),
+  }),
+  // --- Defense -------------------------------------------------------------
+  // Nanite Shield: integrates with the v1 death/collision path — a shielded hit
+  // consumes a charge instead of costing a life (Story 10.4). Fusion: Nanite Lv5 +
+  // Afterburner Lv3 → Phase Armor.
+  Object.freeze({
+    id: 'nanite-shield',
+    name: 'Nanite Shield',
+    title: 'Nanite Shield',
+    track: 'defense',
+    rarity: 5,
+    maxLevel: ITEM_MAX_LEVEL,
+    levels: makeLevels([
+      'Absorb 1 hit, 20s recharge',
+      '15s recharge',
+      '2 charges',
+      '10s recharge',
+      '3 charges + knockback pulse',
+    ]),
+    fusion: Object.freeze({ partner: 'afterburner', epic: 'phase-armor' }),
+  }),
+  // Afterburner: feeds the existing movement seam (Story 10.5). Fusion: Afterburner
+  // Lv5 + Nanite Lv3 → Slipstream (mutually reinforcing with Nanite Shield).
+  Object.freeze({
+    id: 'afterburner',
+    name: 'Afterburner',
+    title: 'Afterburner',
+    track: 'defense',
+    rarity: 3,
+    maxLevel: ITEM_MAX_LEVEL,
+    levels: makeLevels([
+      '+12% move speed',
+      '+20% move speed, dash (3s cd)',
+      '+25% move speed, dash i-frames',
+      '2s dash cd, dash damages on contact',
+      '+35% move speed, burning dash trail',
+    ]),
+    fusion: Object.freeze({ partner: 'nanite-shield', epic: 'slipstream' }),
+  }),
+]);
+
+/**
+ * Look up an item definition by id. Returns the frozen entry, or null when no item
+ * carries that id. The single accessor the offer/application/query surfaces read so
+ * item data has ONE lookup path.
+ * @param {string} id
+ * @returns {(typeof ITEM_REGISTRY)[number]|null}
+ */
+export function getItem(id) {
+  for (let i = 0; i < ITEM_REGISTRY.length; i++) {
+    if (ITEM_REGISTRY[i].id === id) return ITEM_REGISTRY[i];
+  }
+  return null;
+}
+
+/**
+ * All item definitions on a given build track ('offense' | 'defense'), in registry
+ * order. A fresh array per call (never the frozen registry) so callers may sort/slice.
+ * @param {'offense'|'defense'} track
+ * @returns {Array<(typeof ITEM_REGISTRY)[number]>}
+ */
+export function getItemsByTrack(track) {
+  return ITEM_REGISTRY.filter((item) => item.track === track);
+}
