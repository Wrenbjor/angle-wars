+import { describe, it, expect } from 'vitest';
+import {
+  ITEM_REGISTRY,
+  getItem,
+  getItemsByTrack,
+} from './itemRegistry.js';
+import { drawCardOffer } from '../systems/cardOffer.js';
+import { createProgressionState } from '../state/ProgressionState.js';
+import { ITEM_MAX_LEVEL, CARD_OFFER_SIZE } from './constants.js';
+
+// Story 10.1 — the data-driven item registry: ONE definition per item that the offer,
+// on-pick application, owned-state, and current level all read from. These tests pin the
+// definition shape the framework depends on, the getItem/getItemsByTrack accessors, and
+// the register→offer matrix row (the offer draws an item using its registry rarity/track).
+
+const EXPECTED_IDS = ['overcharge', 'spread-cannon', 'nanite-shield', 'afterburner'];
+
+describe('ITEM_REGISTRY — definition shape & invariants', () => {
+  it('registers the four Epic-10 items with distinct ids', () => {
+    const ids = ITEM_REGISTRY.map((it) => it.id);
+    expect(ids).toEqual(EXPECTED_IDS);
+    expect(new Set(ids).size).toBe(ids.length);
+  });
+
+  it('every entry carries the full framework shape (id/name/title/track/rarity/maxLevel)', () => {
+    for (const item of ITEM_REGISTRY) {
+      expect(typeof item.id).toBe('string');
+      expect(item.id.length).toBeGreaterThan(0);
+      expect(typeof item.name).toBe('string');
+      expect(item.name.length).toBeGreaterThan(0);
+      // title stays == name so the existing card overlay's `.title` read keeps working.
+      expect(item.title).toBe(item.name);
+      expect(['offense', 'defense']).toContain(item.track);
+      expect(typeof item.rarity).toBe('number');
+      expect(item.rarity).toBeGreaterThan(0);
+      expect(item.maxLevel).toBe(ITEM_MAX_LEVEL);
+    }
+  });
+
+  it('every entry has a five-level array whose entries carry level/desc/empty stats', () => {
+    for (const item of ITEM_REGISTRY) {
+      expect(item.levels).toHaveLength(ITEM_MAX_LEVEL);
+      item.levels.forEach((lvl, i) => {
+        expect(lvl.level).toBe(i + 1);
+        expect(typeof lvl.desc).toBe('string');
+        expect(lvl.desc.length).toBeGreaterThan(0);
+        // This story registers EMPTY stats — effect numbers land in each item's story.
+        expect(lvl.stats).toEqual({});
+      });
+    }
+  });
+
+  it('every entry has a fusion recipe {partner, epic} (never null this epic)', () => {
+    for (const item of ITEM_REGISTRY) {
+      expect(item.fusion).not.toBeNull();
+      expect(typeof item.fusion.partner).toBe('string');
+      expect(item.fusion.partner.length).toBeGreaterThan(0);
+      expect(typeof item.fusion.epic).toBe('string');
+      expect(item.fusion.epic.length).toBeGreaterThan(0);
+    }
+  });
+
+  it('varies rarities so weighting is observable (not all equal)', () => {
+    const rarities = new Set(ITEM_REGISTRY.map((it) => it.rarity));
+    expect(rarities.size).toBeGreaterThan(1);
+  });
+
+  it('the registry, every entry, its levels array, and each stats map are frozen', () => {
+    expect(Object.isFrozen(ITEM_REGISTRY)).toBe(true);
+    for (const item of ITEM_REGISTRY) {
+      expect(Object.isFrozen(item)).toBe(true);
+      expect(Object.isFrozen(item.levels)).toBe(true);
+      for (const lvl of item.levels) {
+        expect(Object.isFrozen(lvl)).toBe(true);
+        expect(Object.isFrozen(lvl.stats)).toBe(true);
+      }
+      expect(Object.isFrozen(item.fusion)).toBe(true);
+    }
+  });
+});
+
+describe('getItem / getItemsByTrack — the single lookup path', () => {
+  it('getItem returns the frozen definition by id', () => {
+    const oc = getItem('overcharge');
+    expect(oc).toBe(ITEM_REGISTRY[0]);
+    expect(oc.name).toBe('Overcharge');
+  });
+
+  it('getItem returns null for an unknown id', () => {
+    expect(getItem('does-not-exist')).toBeNull();
+  });
+
+  it('getItemsByTrack filters by track (2 offense, 2 defense) as fresh arrays', () => {
+    const offense = getItemsByTrack('offense');
+    const defense = getItemsByTrack('defense');
+    expect(offense.map((it) => it.id)).toEqual(['overcharge', 'spread-cannon']);
+    expect(defense.map((it) => it.id)).toEqual(['nanite-shield', 'afterburner']);
+    // Fresh array (not the frozen registry) so callers can sort/slice it.
+    expect(offense).not.toBe(ITEM_REGISTRY);
+  });
+});
+
+describe('register → offer (I/O matrix row): the draw reads the definition', () => {
+  it('drawCardOffer offers registry items using their track/rarity from the definition', () => {
+    const prog = createProgressionState();
+    let i = 0;
+    const seq = [0.1, 0.5, 0.9, 0.3, 0.7];
+    const rng = () => seq[i++ % seq.length];
+    const offer = drawCardOffer({
+      pool: ITEM_REGISTRY,
+      progressionState: prog,
+      rng,
+    });
+    expect(offer).toHaveLength(CARD_OFFER_SIZE);
+    const ids = offer.map((c) => c.id);
+    expect(new Set(ids).size).toBe(ids.length); // distinct
+    for (const c of offer) expect(ITEM_REGISTRY).toContain(c);
+  });
+});
