+import { describe, it, expect } from 'vitest';
+import { createPlayerStats, recomputePlayerStats } from './PlayerStats.js';
+import { ITEM_REGISTRY } from '../config/itemRegistry.js';
+
+// Story 10.1 — the runtime PlayerStats modifier store + its on-change fold. The fold is
+// pure and in-place: reset every field to its base, then add each owned item's CURRENT-
+// level `stats` contribution. It reads the current level only (per-level entries are
+// totals-at-that-level, not deltas across levels), skips unowned/unknown ids, and runs
+// only on a level change. A SYNTHETIC-fixture registry proves the fold (the real Epic-10
+// items carry empty stats today, so the fold is a no-op on real content).
+
+// A synthetic registry with NON-empty per-level stats, so the fold has real content to
+// verify. Two items across the multiplier + additive field vocabularies.
+const FIXTURE = [
+  {
+    id: 'dmg',
+    track: 'offense',
+    maxLevel: 5,
+    levels: [
+      { level: 1, desc: 'L1', stats: { damageMult: 0.1 } },
+      { level: 2, desc: 'L2', stats: { damageMult: 0.25, fireRateMult: 0.1 } },
+      { level: 3, desc: 'L3', stats: { damageMult: 0.35, fireRateMult: 0.2 } },
+      { level: 4, desc: 'L4', stats: { damageMult: 0.45, fireRateMult: 0.3 } },
+      { level: 5, desc: 'L5', stats: { damageMult: 0.6, fireRateMult: 0.4 } },
+    ],
+  },
+  {
+    id: 'shield',
+    track: 'defense',
+    maxLevel: 5,
+    levels: [
+      { level: 1, desc: 'L1', stats: { shieldCharges: 1 } },
+      { level: 2, desc: 'L2', stats: { shieldCharges: 1 } },
+      { level: 3, desc: 'L3', stats: { shieldCharges: 2 } },
+      { level: 4, desc: 'L4', stats: { shieldCharges: 2 } },
+      { level: 5, desc: 'L5', stats: { shieldCharges: 3 } },
+    ],
+  },
+];
+
+describe('createPlayerStats — neutral base store', () => {
+  it('multiplier fields base at 1, additive/count fields base at 0', () => {
+    const ps = createPlayerStats();
+    expect(ps.damageMult).toBe(1);
+    expect(ps.fireRateMult).toBe(1);
+    expect(ps.moveSpeedMult).toBe(1);
+    expect(ps.shieldCharges).toBe(0);
+  });
+
+  it('returns a fresh independent object each call', () => {
+    expect(createPlayerStats()).not.toBe(createPlayerStats());
+  });
+});
+
+describe('recomputePlayerStats — the current-level fold', () => {
+  it('folds a single owned item at its current level onto the base', () => {
+    const ps = createPlayerStats();
+    recomputePlayerStats(ps, { dmg: 1 }, FIXTURE);
+    // base 1 + L1 damageMult 0.1 = 1.1; fireRateMult untouched (L1 has none).
+    expect(ps.damageMult).toBeCloseTo(1.1);
+    expect(ps.fireRateMult).toBe(1);
+    expect(ps.shieldCharges).toBe(0);
+  });
+
+  it('reads the CURRENT level total, not the sum across levels', () => {
+    const ps = createPlayerStats();
+    recomputePlayerStats(ps, { dmg: 3 }, FIXTURE);
+    // L3 totals (0.35 / 0.2) — NOT L1+L2+L3 summed. Proves per-level = totals-at-level.
+    expect(ps.damageMult).toBeCloseTo(1.35);
+    expect(ps.fireRateMult).toBeCloseTo(1.2);
+  });
+
+  it('sums contributions across multiple owned items additively', () => {
+    const ps = createPlayerStats();
+    recomputePlayerStats(ps, { dmg: 5, shield: 3 }, FIXTURE);
+    expect(ps.damageMult).toBeCloseTo(1.6);
+    expect(ps.fireRateMult).toBeCloseTo(1.4);
+    expect(ps.shieldCharges).toBe(2); // shield L3 → 2 charges (additive onto base 0)
+  });
+
+  it('resets to base each call (no accumulation across recomputes)', () => {
+    const ps = createPlayerStats();
+    recomputePlayerStats(ps, { dmg: 5 }, FIXTURE); // damageMult 1.6
+    recomputePlayerStats(ps, { dmg: 1 }, FIXTURE); // now level 1 only
+    expect(ps.damageMult).toBeCloseTo(1.1); // reset then refolded, not 1.6 + 0.1
+  });
+
+  it('skips levels < 1 and unknown ids', () => {
+    const ps = createPlayerStats();
+    recomputePlayerStats(ps, { dmg: 0, mystery: 4 }, FIXTURE);
+    expect(ps.damageMult).toBe(1); // dmg at level 0 folds nothing; mystery unknown
+    expect(ps.fireRateMult).toBe(1);
+    expect(ps.shieldCharges).toBe(0);
+  });
+
+  it('is deterministic: same owned set folded twice → identical stats', () => {
+    const a = createPlayerStats();
+    const b = createPlayerStats();
+    recomputePlayerStats(a, { dmg: 4, shield: 2 }, FIXTURE);
+    recomputePlayerStats(b, { dmg: 4, shield: 2 }, FIXTURE);
+    expect(a).toEqual(b);
+  });
+
+  it('mutates the passed object in place (no per-call reallocation)', () => {
+    const ps = createPlayerStats();
+    const ret = recomputePlayerStats(ps, { dmg: 2 }, FIXTURE);
+    // Fold returns nothing and reuses the passed object — no new store allocated.
+    expect(ret).toBeUndefined();
+    expect(ps.damageMult).toBeCloseTo(1.25);
+  });
+
+  it('the REAL Epic-10 registry has empty stats → the fold is a no-op (base preserved)', () => {
+    const ps = createPlayerStats();
+    // Own every real item at various levels; all carry empty `stats` this story.
+    recomputePlayerStats(
+      ps,
+      { overcharge: 5, 'spread-cannon': 3, 'nanite-shield': 4, afterburner: 2 },
+      ITEM_REGISTRY,
+    );
+    expect(ps).toEqual(createPlayerStats());
+  });
+});
