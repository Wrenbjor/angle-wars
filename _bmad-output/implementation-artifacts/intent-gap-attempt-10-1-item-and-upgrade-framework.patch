index 0000000..b57bac8
--- /dev/null
+++ b/src/state/PlayerStats.js
@@ -0,0 +1,85 @@
+// PlayerStats — the runtime player-stat modifier store + its on-change fold
+// (Story 10.1 / Epic 10, plain data, Phaser-free).
+//
+// A single mutable modifier object the gameplay seams will read (Overcharge's global
+// fire modifiers, Afterburner's move-speed, Nanite Shield's charge count, etc. — each
+// wired in its own story 10.2–10.5). It is derived, not authored: recomputePlayerStats
+// folds every owned item's CURRENT-level `stats` contribution onto a fresh base, and it
+// runs ONLY on a level change (an on-pick recompute in LevelUpSystem), never per frame —
+// so the hot loop reads cached derived stats with zero per-frame allocation.
+//
+// The base values encode the neutral identity for each kind of field: a MULTIPLIER
+// field bases at 1 (no scaling) and an ADDITIVE/COUNT field bases at 0 (nothing added).
+// Item `stats` maps add onto that base (a +0.15 damageMult contribution makes the field
+// 1.15). The vocabulary starts minimal here; each item story extends it with the fields
+// its effect needs. Because Story 10.1's registered items carry EMPTY `stats`, the fold
+// is a no-op on real content today — the framework is real; the item numbers are each
+// story's job — and is proven by a synthetic-fixture test.
+
+/**
+ * Create the runtime player-stat modifier store at its neutral base: every multiplier
+ * field at 1 (no scaling) and every additive/count field at 0 (nothing added). Built
+ * fresh per run beside playerState/progressionState; recomputePlayerStats mutates it in
+ * place on each level change.
+ * @returns {{ damageMult: number, fireRateMult: number, moveSpeedMult: number,
+ *   shieldCharges: number }}
+ */
+export function createPlayerStats() {
+  return {
+    // Multiplier fields (base 1 — no scaling).
+    damageMult: 1,
+    fireRateMult: 1,
+    moveSpeedMult: 1,
+    // Additive/count fields (base 0 — nothing added).
+    shieldCharges: 0,
+  };
+}
+
+// Reset every field of `ps` to its neutral base in place (multiplier fields → 1,
+// additive/count fields → 0). Kept in lockstep with createPlayerStats's field set so a
+// recompute starts from the identical base without allocating a new object.
+function resetToBase(ps) {
+  ps.damageMult = 1;
+  ps.fireRateMult = 1;
+  ps.moveSpeedMult = 1;
+  ps.shieldCharges = 0;
+}
+
+// Linear scan for an item id within the PASSED registry (not the global one), so the
+// fold works against synthetic test fixtures as well as ITEM_REGISTRY. Returns the entry
+// or undefined; allocates nothing (no map build, no closure), preserving the zero-per-
+// call-allocation guarantee for a registry of this size.
+function findInRegistry(registry, id) {
+  for (let i = 0; i < registry.length; i++) {
+    if (registry[i].id === id) return registry[i];
+  }
+  return undefined;
+}
+
+/**
+ * Recompute `playerStats` in place: reset every field to its base, then add each owned
+ * item's CURRENT-level `stats` contribution additively. The fold reads ONLY the current
+ * level's entry (per-level `stats` are totals-at-that-level, not deltas summed across
+ * levels), skips levels < 1 and unknown ids, and mutates `playerStats` with no per-call
+ * allocation beyond the passed object. Pure over its inputs: the same owned set + registry
+ * always yields the identical result. Invoked only on a level change (LevelUpSystem's
+ * on-pick), never per frame.
+ * @param {object} playerStats The modifier store to mutate in place (from createPlayerStats).
+ * @param {Object<string, number>} ownedCards id → owned count (an item's level).
+ * @param {ReadonlyArray<{ id: string, levels: Array<{ stats: object }> }>} registry
+ */
+export function recomputePlayerStats(playerStats, ownedCards, registry) {
+  resetToBase(playerStats);
+  for (const id in ownedCards) {
+    const level = ownedCards[id];
+    if (level < 1) continue;
+    const item = findInRegistry(registry, id);
+    if (!item) continue;
+    const entry = item.levels[level - 1];
+    const stats = entry && entry.stats;
+    if (!stats) continue;
+    for (const key in stats) {
+      playerStats[key] = (playerStats[key] ?? 0) + stats[key];
+    }
+  }
+}
